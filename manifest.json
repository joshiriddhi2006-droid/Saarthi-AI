{
  "manifest_version": 3,
  "name": "Saarthi-AI - Accessibility Layer",
  "version": "1.2.0",
  "description": "An AI-powered accessibility layer helping users interact with webpages through voice, simplified content, and assistive navigation.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Saarthi-AI"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
